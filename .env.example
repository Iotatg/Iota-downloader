# ---------------------------------------------------------------------------
# Iota Coder Downloader Bot - environment template
# Copy this file to .env and fill in the values before starting the bot.
# ---------------------------------------------------------------------------

# Telegram credentials (required)
BOT_TOKEN=123456:replace-with-your-bot-token
ADMIN_ID=123456789
# Additional admins, comma separated. Every listed id can use the admin commands.
ADMIN_IDS=
DATABASE_URL=postgres://iota:iota@postgres:5432/iota_downloader?sslmode=disable

# Telegram application credentials (required). The bot talks to Telegram over
# MTProto, it needs the identifier and the hash of the application the bot
# belongs to. Both values come from https://my.telegram.org/apps, the same
# application can serve several bots.
API_ID=1234567
API_HASH=replace-with-the-api-hash

# File that keeps the MTProto session of the bot. The session holds the
# authorization of the bot, it is created on the first start and reused after
# that. The folder of the file must exist.
MTPROTO_SESSION=/app/session/iota

# Optional Telegram extras
MEASUREMENT_ID=
API_SECRET=
CHANNEL_ID=

# Appearance. DISABLE_COLOUR=true removes the random colours of the buttons and
# leaves them in the colour of the client.
DISABLE_COLOUR=false

# Cobalt backend used for Pinterest and SoundCloud
COBALT_API_URL=https://api.cobalt.tools
COBALT_API_KEY=

# Instagram. Instagram answers anonymous requests with a login wall, so a
# session is required. Either paste the sessionid cookie of a logged-in
# browser session or export the whole cookie jar of Instagram into a file.
# The session opens Threads as well, Threads belongs to the same platform.
# INSTAGRAM_COOKIES_FILE=/app/cookies/instagram.txt
INSTAGRAM_SESSIONID=
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_APP_ID=936619743392459

# Spotify Web API credentials used to resolve Spotify tracks
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=UA

# Own iota-api instance. It resolves Spotify and SoundCloud tracks and proxies
# the audio, so those sources keep working when no Cobalt backend answers.
# Create a key with POST /admin/keys and put the plaintext into IOTA_API_KEY.
# The api resolves a Spotify track on YouTube, it needs a cookie jar of its own
# (YOUTUBE_COOKIES_FILE on the api), a datacenter ip is refused without one.
# IOTA_API_URL=http://127.0.0.1:8000
IOTA_API_URL=
IOTA_API_KEY=

# Ritesh api. A multi platform resolver that delivers YouTube, Spotify, Apple
# Music, JioSaavn, Deezer, Gaana, Tidal and Dailymotion media. It answers when
# the own resolver of a platform is blocked and it serves the music platforms
# that have no public download link. The provider stays off until an address
# or a key is set, the free key of the public api is used then.
# RITESH_API_URL=https://api.riteshyt.in
RITESH_API_URL=
RITESH_API_KEY=

# Resolution cache. A resolved link is remembered for a few minutes, so the
# same link is answered without asking the platform again.
RESOLUTION_CACHE_TTL_SECONDS=300
RESOLUTION_CACHE_MAX_ENTRIES=500

# Playlists, albums, boards and radio mixes. The bot expands such a link into
# a menu, the entries are picked one by one or the whole list is sent at once.
# COLLECTION_MAX_ITEMS limits the number of the entries of a list.
COLLECTION_MAX_ITEMS=50
COLLECTION_PAGE_SIZE=10
COLLECTION_CACHE_TTL_SECONDS=1800
COLLECTION_CACHE_MAX_ENTRIES=50

# Storage
OUTPUT_DIR=/app/downloads
LOG_DIR=/app/logs
MAX_FILE_SIZE=2147483648

# Split the files that are bigger than the upload limit into parts.
SPLIT_LARGE_FILES=true

# Size limit of a single upload over MTProto. The server refuses every file
# part at or beyond 2000 MB, a bigger file is split into parts.
MTPROTO_FILE_LIMIT_MB=2000

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=15

# Anti flood limits
ANTIFLOOD_MESSAGE_LIMIT=4
ANTIFLOOD_MESSAGE_WINDOW_SECONDS=2
ANTIFLOOD_CALLBACK_LIMIT=6
ANTIFLOOD_CALLBACK_WINDOW_SECONDS=2
ANTIFLOOD_INLINE_LIMIT=4
ANTIFLOOD_INLINE_WINDOW_SECONDS=3
ANTIFLOOD_GUEST_LIMIT=4
ANTIFLOOD_GUEST_WINDOW_SECONDS=3
ANTIFLOOD_GLOBAL_LIMIT=8
ANTIFLOOD_GLOBAL_WINDOW_SECONDS=3
ANTIFLOOD_COOLDOWN_SECONDS=6
ANTIFLOOD_USER_TTL_SECONDS=180
ANTIFLOOD_MAX_TRACKED_USERS=50000

# Request deduplication
REQUEST_DEDUPE_ACTIVE_TTL_SECONDS=900
REQUEST_DEDUPE_COMPLETED_TTL_SECONDS=12
REQUEST_DEDUPE_MAX_ENTRIES=50000

# Download queue
DOWNLOAD_QUEUE_MIN_WORKERS=3
DOWNLOAD_QUEUE_MAX_WORKERS=7
DOWNLOAD_QUEUE_MAX_SIZE=250
DOWNLOAD_QUEUE_PER_USER_RATE_LIMIT=4
DOWNLOAD_QUEUE_PER_USER_WINDOW_SECONDS=10
DOWNLOAD_QUEUE_PER_USER_MAX_PENDING=3
DOWNLOAD_QUEUE_SCALE_COOLDOWN_SECONDS=8
DOWNLOAD_QUEUE_IDLE_SCALE_DOWN_SECONDS=35
DOWNLOAD_MAX_WORKERS_CAP=6

# Batch link handling
BATCH_LINKS_MAX_ITEMS=6
BATCH_LINKS_MIN_CONCURRENCY=1
BATCH_LINKS_MAX_CONCURRENCY=4
BATCH_LINKS_PARALLEL_QUEUE_DEPTH_THRESHOLD=4
BATCH_LINKS_PARALLEL_ACTIVE_JOBS_THRESHOLD=5

# yt-dlp tuning for YouTube
YTDLP_YOUTUBE_COOKIES_FILE=
YTDLP_YOUTUBE_COOKIES_FROM_BROWSER=
YTDLP_YOUTUBE_PLAYER_CLIENT=
YTDLP_YOUTUBE_PO_TOKEN=
YTDLP_YOUTUBE_REMOTE_COMPONENTS=
YTDLP_YOUTUBE_JS_RUNTIMES=
YTDLP_YOUTUBE_INFO_TIMEOUT_SECONDS=30
YTDLP_YOUTUBE_SLEEP_REQUESTS_SECONDS=0
YTDLP_YOUTUBE_SLEEP_INTERVAL_SECONDS=0
YTDLP_YOUTUBE_MAX_SLEEP_INTERVAL_SECONDS=0

# Cookies of the platforms that ask for a session, Reddit and Facebook for
# example. The file holds the cookies of a logged in browser session in the
# netscape format, it is used by every yt-dlp call. The youtube cookies are
# used when no file is given here.
# YTDLP_COOKIES_FILE=/app/cookies/platforms.txt
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=

# Session and polling
BOT_POLLING_TASKS_CONCURRENCY_LIMIT=256
BOT_SESSION_CONNECTION_LIMIT=400
DEBUG=false
